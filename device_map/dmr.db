    <table id="device_map_timing_constraint" title="Timing Constraint" column_number="1">
        <column_headers>
            <data>Command</data>
        </column_headers>
        <row>
            <data>create_clock -name {sys_clk} -period {20.000} -waveform {0 10} [get_ports {clk}]</data>
        </row>
        <row>
            <data>create_generated_clock -name {ddrphy_clkin} -source [get_ports {clk}] [get_pins {u_ddr.I_GTP_CLKDIV/CLKDIVOUT}] -master_clock [get_clocks {sys_clk}] -multiply_by {16} -divide_by {8}</data>
        </row>
        <row>
            <data>create_generated_clock -name {ioclk0} -source [get_ports {clk}] [get_pins {u_ddr.I_GTP_IOCLKBUF_0/CLKOUT}] -master_clock [get_clocks {sys_clk}] -multiply_by {16} -divide_by {2}</data>
        </row>
        <row>
            <data>create_generated_clock -name {ioclk1} -source [get_ports {clk}] [get_pins {u_ddr.I_GTP_IOCLKBUF_1/CLKOUT}] -master_clock [get_clocks {sys_clk}] -multiply_by {16} -divide_by {2}</data>
        </row>
        <row>
            <data>create_generated_clock -name {ioclk2} -source [get_ports {clk}] [get_pins {u_ddr.I_GTP_IOCLKBUF_2/CLKOUT}] -master_clock [get_clocks {sys_clk}] -multiply_by {16} -divide_by {2}</data>
        </row>
        <row>
            <data>create_generated_clock -name {ioclk_gate_clk} -source [get_ports {clk}] [get_pins {u_ddr.u_clkbufg_gate/CLKOUT}] -master_clock [get_clocks {sys_clk}] -multiply_by {16} -divide_by {8}</data>
        </row>
        <row>
            <data>set_clock_groups -asynchronous -group [get_clocks {sys_clk ddrphy_clkin}] -group [get_clocks {ioclk0}] -group [get_clocks {ioclk1}] -group [get_clocks {ioclk2}] -group [get_clocks {ioclk_gate_clk}]</data>
        </row>
        <row>
            <data>set_clock_uncertainty {0.200} [get_clocks {ddrphy_clkin}]  -setup -hold</data>
        </row>
        <row>
            <data>set_max_delay 15.000 -datapath_only -from [get_cells -hierarchical {*u_mem_bridge*req_*hold*}] -to [get_cells -hierarchical {*u_mem_bridge*native_*}]</data>
        </row>
        <row>
            <data>set_max_delay 15.000 -datapath_only -from [get_cells -hierarchical {*u_mem_bridge*rsp_*hold*}] -to [get_cells -hierarchical {*u_mem_bridge*rsp_data*}]</data>
        </row>
        <row>
            <data>set_max_delay 15.000 -datapath_only -from [get_cells -hierarchical {*u_mem_bridge*req_write_hold*}] -to [get_cells -hierarchical {*u_mem_bridge*state*}]</data>
        </row>
        <row>
            <data>set_false_path -from [get_ports {rstn}]</data>
        </row>
        <row>
            <data>set_false_path -from [get_ports {keys_n[*]}] -to [get_cells -hierarchical {*key_meta*}]</data>
        </row>
        <row>
            <data>set_false_path -from [get_ports {gpio[*]}] -to [get_cells -hierarchical {*gpio_meta*}]</data>
        </row>
        <row>
            <data>set_false_path -from [get_ports {uart_rx}] -to [get_cells -hierarchical {*rx_meta*}]</data>
        </row>
        <row>
            <data>set_false_path -to [get_cells -hierarchical {*u_mem_bridge*ack_meta*}]</data>
        </row>
        <row>
            <data>set_false_path -to [get_cells -hierarchical {*u_mem_bridge*req_meta*}]</data>
        </row>
        <row>
            <data>set_false_path -to [get_cells -hierarchical {*u_mem_bridge*init_meta*}]</data>
        </row>
        <row>
            <data>set_false_path -from [get_cells -hierarchical {*u_ddr*u_ddrp_rstn_sync*}] -to [get_cells -hierarchical {*u_ddr*u_controller_reset_sync*}]</data>
        </row>
        <row>
            <data>set_false_path -from [get_cells -hierarchical {*reset_release*}] -to [get_cells -hierarchical {*ddr_release*}]</data>
        </row>
        <row>
            <data>set_false_path -from [get_cells -hierarchical {*u_ddr*ddrphy_reset_ctrl*ddrphy_dqs_rst*}] -to [get_cells -hierarchical {*u_ddr*ddrphy_slice_top*}]</data>
        </row>
        <row>
            <data>set_false_path -from [get_cells -hierarchical {*u_ddr*ddrphy_reset_ctrl*}] -to [get_cells -hierarchical {*u_ddr*ddrphy_reset_ctrl*u_ddrphy_rstn_sync*}]</data>
        </row>
        <row>
            <data>set_false_path -from [get_cells -hierarchical {*u_ddr*ddrphy_reset_ctrl*}] -to [get_cells -hierarchical {*u_ddr*ddrphy_reset_ctrl*u_dll_rst_sync*}]</data>
        </row>
        <row>
            <data>set_false_path -from [get_cells -hierarchical {*u_ddr*ddrphy_reset_ctrl*logic_rstn*}] -to [get_cells -hierarchical {*u_ddr*ddrphy_slice_top*u_logic_rstn_sync*}]</data>
        </row>
        <row>
            <data>set_false_path -to [get_cells -hierarchical {*u_ddr*gate_error_ref_meta*}]</data>
        </row>
        <row>
            <data>set_false_path -hold -from [get_cells -hierarchical {*u_mem_bridge*req_*hold*}] -to [get_cells -hierarchical {*u_mem_bridge*native_*}]</data>
        </row>
        <row>
            <data>set_false_path -hold -from [get_cells -hierarchical {*u_mem_bridge*req_write_hold*}] -to [get_cells -hierarchical {*u_mem_bridge*state*}]</data>
        </row>
        <row>
            <data>set_false_path -hold -from [get_cells -hierarchical {*u_mem_bridge*rsp_*hold*}] -to [get_cells -hierarchical {*u_mem_bridge*rsp_data*}]</data>
        </row>
    </table>
