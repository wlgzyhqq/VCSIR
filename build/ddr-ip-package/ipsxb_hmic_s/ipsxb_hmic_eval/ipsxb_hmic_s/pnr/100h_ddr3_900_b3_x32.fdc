###==== BEGIN Clocks
create_clock -name {ref_clk} [get_ports {ref_clk}] -period {20.0} -waveform {0 10.0}
create_clock -name {free_clk} [get_ports {free_clk}] -period {10.0} -waveform {0.0 5.0}
###==== END Clocks

###==== BEGIN "Generated Clocks"
create_generated_clock -name {ddrphy_clkin} -source [get_ports {ref_clk}] [get_pins {I_ipsxb_ddr_top.I_GTP_CLKDIV/CLKDIVOUT}] -master_clock [get_clocks {ref_clk}] -multiply_by {32} -divide_by {16}
create_generated_clock -name {ioclk0} -source [get_ports {ref_clk}] [get_pins {I_ipsxb_ddr_top.I_GTP_IOCLKBUF_0/CLKOUT}] -master_clock [get_clocks {ref_clk}] -multiply_by {32} -divide_by {4}
create_generated_clock -name {ioclk1} -source [get_ports {ref_clk}] [get_pins {I_ipsxb_ddr_top.I_GTP_IOCLKBUF_1/CLKOUT}] -master_clock [get_clocks {ref_clk}] -multiply_by {32} -divide_by {4}
create_generated_clock -name {ioclk2} -source [get_ports {ref_clk}] [get_pins {I_ipsxb_ddr_top.I_GTP_IOCLKBUF_2/CLKOUT}] -master_clock [get_clocks {ref_clk}] -multiply_by {32} -divide_by {4}
create_generated_clock -name {ioclk_gate_clk} -source [get_ports {ref_clk}] [get_pins {I_ipsxb_ddr_top.u_clkbufg_gate/CLKOUT}] -master_clock [get_clocks {ref_clk}] -multiply_by {32} -divide_by {16}
###==== END "Generated Clocks"

###==== BEGIN "Inputs/Outpusts"
###==== END "Inputs/Outpusts"

###==== BEGIN "Delay Paths"
###==== END "Delay Paths"

###==== BEGIN set_clock_group"
set_clock_groups -name ref_clk -asynchronous -group [get_clocks {ref_clk}]
set_clock_groups -name free_clk -asynchronous -group [get_clocks {free_clk}]
set_clock_groups -name ioclk0 -asynchronous -group [get_clocks {ioclk0}]
set_clock_groups -name ioclk1 -asynchronous -group [get_clocks {ioclk1}]
set_clock_groups -name ioclk2 -asynchronous -group [get_clocks {ioclk2}]
set_clock_groups -name ioclk_gate_clk -asynchronous -group [get_clocks {ioclk_gate_clk}]
###==== END "set_clock_group"

###==== BEGIN set_clock_uncertainty"
set_clock_uncertainty {0.200} [get_clocks {ddrphy_clkin}]  -setup -hold
###==== END "set_clock_group"

###==== BEGIN Attributes
define_attribute {i:I_ips_ddr_top.u_ipsxb_ddrphy_pll_0.u_pll_e3} {PAP_LOC} {PLL_190_199} 
define_attribute {i:I_ips_ddr_top.u_ipsxb_ddrphy_pll_1.u_pll_e3} {PAP_LOC} {PLL_190_179}  
define_attribute {i:I_ipsxb_ddr_top.u_ddrphy_top.ddrphy_reset_ctrl.ddrphy_ioclk_gate} {PAP_LOC} {CLMA_186_192:FF3}
###==== END Attributes

