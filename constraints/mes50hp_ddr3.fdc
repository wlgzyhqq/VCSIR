define_attribute {p:ddr3_addr[15]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:ddr3_addr[15]} {PAP_IO_LOC} {R7}
define_attribute {p:ddr3_addr[15]} {PAP_IO_VCCIO} {1.5}
