define_attribute {p:hdmi_data[20]} {PAP_IO_LOC} {K22}
define_attribute {p:hdmi_data[20]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:hdmi_data[20]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:hdmi_data[20]} {PAP_IO_NONE} {TRUE}
define_attribute {p:hdmi_data[20]} {PAP_IO_DRIVE} {8}
define_attribute {p:hdmi_data[20]} {PAP_IO_SLEW} {FAST}
define_attribute {p:hdmi_data[21]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:hdmi_data[21]} {PAP_IO_LOC} {H21}
define_attribute {p:hdmi_data[21]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:hdmi_data[21]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:hdmi_data[21]} {PAP_IO_NONE} {TRUE}
define_attribute {p:hdmi_data[21]} {PAP_IO_DRIVE} {8}
define_attribute {p:hdmi_data[21]} {PAP_IO_SLEW} {FAST}
define_attribute {p:hdmi_data[22]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:hdmi_data[22]} {PAP_IO_LOC} {H22}
define_attribute {p:hdmi_data[22]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:hdmi_data[22]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:hdmi_data[22]} {PAP_IO_NONE} {TRUE}
define_attribute {p:hdmi_data[22]} {PAP_IO_DRIVE} {8}
define_attribute {p:hdmi_data[22]} {PAP_IO_SLEW} {FAST}
define_attribute {p:hdmi_data[23]} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:hdmi_data[23]} {PAP_IO_LOC} {H19}
define_attribute {p:hdmi_data[23]} {PAP_IO_VCCIO} {3.3}
define_attribute {p:hdmi_data[23]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:hdmi_data[23]} {PAP_IO_NONE} {TRUE}
define_attribute {p:hdmi_data[23]} {PAP_IO_DRIVE} {8}
define_attribute {p:hdmi_data[23]} {PAP_IO_SLEW} {FAST}
# Reference PLL: pixel 74.21875 MHz, configuration 9.97899 MHz.
# 1650 * 750 pixels -> 59.9747 Hz; reference PA=04 samples falling edge.
create_generated_clock -name {hdmi_pixel} -source [get_ports {clk}] -multiply_by {95} -divide_by {64} [get_pins {u_hdmi/u_pixel_pll/u_pll_e3/CLKOUT0}]
create_generated_clock -name {hdmi_cfg} -source [get_ports {clk}] -multiply_by {95} -divide_by {476} [get_pins {u_hdmi/u_pixel_pll/u_pll_e3/CLKOUT1}]
create_generated_clock -name {hdmi_forward} -source [get_pins {u_hdmi/u_pixel_pll/u_pll_e3/CLKOUT0}] -divide_by {1} [get_ports {hdmi_pclk}]
set_clock_uncertainty {0.200} [get_clocks {hdmi_pixel hdmi_forward}] -setup -hold
# Same engineering budget as the board-verified 720p reference check.
# These 2 ns setup / 1 ns hold budgets are not measured board delays.
set_output_delay -clock [get_clocks {hdmi_forward}] -clock_fall -max {2.000} [get_ports {hdmi_hs hdmi_vs hdmi_de hdmi_data[*]}]
set_output_delay -clock [get_clocks {hdmi_forward}] -clock_fall -min {-1.000} [get_ports {hdmi_hs hdmi_vs hdmi_de hdmi_data[*]}]
# Only first-stage synchronizers are excluded, not whole clock domains.
set_false_path -to [get_cells -hierarchical {*u_hdmi*req_meta*}]
set_false_path -to [get_cells -hierarchical {*u_hdmi*ack_meta*}]
set_false_path -to [get_cells -hierarchical {*u_hdmi*flags_meta*}]
set_false_path -to [get_cells -hierarchical {*u_hdmi*lock_meta*}]
set_false_path -to [get_cells -hierarchical {*u_hdmi*ready_meta*}]
set_false_path -from [get_cells -hierarchical {*reset_release*}] -to [get_cells -hierarchical {*u_hdmi*cfg_release*}]
set_false_path -from [get_pins {u_hdmi/u_pixel_pll/u_pll_e3/LOCK}] -to [get_cells -hierarchical {*u_hdmi*cfg_release*}]
# Configuration-domain assertion goes to asynchronous reset of the pixel
# release synchronizer; pixel-clock stage 0 -> stage 1 is still checked.
set_false_path -from [get_clocks {hdmi_cfg}] -to [get_cells -hierarchical {*u_hdmi*pixel_release*}]
# Held payload is captured only after two request synchronizer stages and
# frame boundary. Capture finishes before ack releases the source hold.
set_max_delay {15.000} -datapath_only -from [get_cells -hierarchical {*u_hdmi*control_hold*}] -to [get_cells -hierarchical {*u_hdmi*frame_control*}]
set_false_path -hold -from [get_cells -hierarchical {*u_hdmi*control_hold*}] -to [get_cells -hierarchical {*u_hdmi*frame_control*}]
# Terminal page/cursor payload is frozen before request and until ack. Only
# the first toggle/ready synchronizers match the existing meta exceptions.
# Keep second synchronizer stages, RAM ports, renderer and output pads timed.
set_max_delay {15.000} -datapath_only -from [get_cells -hierarchical {*u_hdmi*u_terminal*payload_hold*}] -to [get_cells -hierarchical {*u_hdmi*u_terminal*frame_payload*}]
set_false_path -hold -from [get_cells -hierarchical {*u_hdmi*u_terminal*payload_hold*}] -to [get_cells -hierarchical {*u_hdmi*u_terminal*frame_payload*}]
# Gray frame counter changes once per frame; constrain its first-stage bus
# arrival instead of excluding setup paths for an entire domain.
set_max_delay {15.000} -datapath_only -from [get_cells -hierarchical {*u_hdmi*u_terminal*frame_gray*}] -to [get_cells -hierarchical {*u_hdmi*u_terminal*frame_meta*}]
set_false_path -hold -from [get_cells -hierarchical {*u_hdmi*u_terminal*frame_gray*}] -to [get_cells -hierarchical {*u_hdmi*u_terminal*frame_meta*}]
# HMIC_S training_error_d is an existing two-register reference-clock
# synchronizer (confirmed in generated netlist: stage 1 D is stage 0 Q).
# Exclude only its UI-clock input paths. The ref-clock stage 0 -> 1 path
# remains timed because its launch clock is sys_clk, not ddrphy_clkin.
set_false_path -from [get_clocks {ddrphy_clkin}] -to [get_cells -hierarchical {*u_ddr*ddrphy_reset_ctrl*training_error_d*}]

