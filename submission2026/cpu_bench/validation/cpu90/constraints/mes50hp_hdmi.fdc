define_attribute {p:hdmi_data[19]} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:hdmi_data[19]} {PAP_IO_NONE} {TRUE}
define_attribute {p:hdmi_data[19]} {PAP_IO_DRIVE} {8}
define_attribute {p:hdmi_data[19]} {PAP_IO_SLEW} {FAST}
